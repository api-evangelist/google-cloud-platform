      "id": "55dc7f8f-6561-444f-8cab-4a91cdb276ef",
      "name": "TagKeys",
      "description": {
        "content": "Manage tag keys used to organize and categorize Google Cloud resources. Tag keys define the namespace for tag values that can be attached to resources.",
        "type": "text/plain"
      },
      "item": [
