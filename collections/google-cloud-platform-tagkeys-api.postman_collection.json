          "name": "Google Cloud Platform List Tag Keys",
          "request": {
            "name": "Google Cloud Platform List Tag Keys",
            "description": {
              "content": "Lists all tag keys under a specified parent resource. The parent can be an organization. The caller must have the resourcemanager.tagKeys.list permission on the parent.",
              "type": "text/plain"
            },
