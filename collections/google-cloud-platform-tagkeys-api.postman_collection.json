              "path": [
                "v3",
                "tagKeys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "parent",
                  "value": "<string>",
                  "description": "(Required) The resource name of the parent. Must be of the form organizations/{org_id}."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Maximum number of tag keys to return."
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Pagination token from a previous list call."
